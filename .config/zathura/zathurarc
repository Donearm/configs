set recolor false
set recolor-keephue true
set font "monospace light 24"
set default-fg #6f90b0
set default-bg #dcdcdc
set index-fg #6f90b0
set index-bg #dcdcdc
set index-active-fg #656565
set index-active-bg #fefefe
set completion-bg #dcdcdc
set completion-fg #678787
set completion-highlight-bg #dcdcdc
set completion-highlight-fg #646467
set selection-clipboard clipboard
set window-title-basename true
set window-title-home-tilde true
set window-title-page true
set guioptions cshv
set selection-clipboard clipboard

set adjust-open "width"
set scroll-wrap false
set statusbar-home-tilde true
set window-title-home-tilde true
set window-title-page true
set guioptions "v"
map [fullscreen] <PageDown> scroll full-down
map [fullscreen] <PageUp> scroll full-up
map [normal] <PageDown> scroll full-down
map [normal] <PageUp> scroll full-up
